# ======================================
# MoneyLens Backend - Docker Environment
# ======================================
# Copy this file and fill in your values
# DO NOT commit this file with real secrets!
# ---- Server ----
HOST=0.0.0.0
PORT=5000
# ---- Frontend (CORS) ----
HOSTFE=localhost
PORTFE=5173
# ---- PostgreSQL ----
PGUSER=moneylens
PGPASSWORD=change_me_strong_password
PGDATABASE=moneylens_db
PGHOST=postgres
PGPORT=5432
# ---- JWT Secrets ----
ACCESS_TOKEN_KEY=your_access_token_secret_here
REFRESH_TOKEN_KEY=your_refresh_token_secret_here
# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
# ---- SMTP (Email) ----
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ---- node-pg-migrate ----
DATABASE_URL=postgres://moneylens:change_me_strong_password@postgres:5432/moneylens_db
