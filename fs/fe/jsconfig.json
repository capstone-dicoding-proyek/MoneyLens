{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,

    "allowJs": true,
    "checkJs": false,

    "isolatedModules": true,
    "noEmit": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "skipLibCheck": true
  },

  "exclude": [
    "node_modules",
    "dist"
  ]
}